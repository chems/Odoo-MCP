# OpenAI
OPENAI_API_KEY=...

# Queue / Redis (Railway Redis / Upstash)
REDIS_URL=redis://...

# Odoo SaaS (JSON-RPC)
ODOO_URL=https://<your-odoo-domain>
ODOO_DB=<db_name>
ODOO_UID=<uid_number>
ODOO_API_KEY=<user_api_key_or_token>

# Ingestion auth (Odoo -> service)
INGEST_SHARED_SECRET=change_me

# Optional (Postgres)
DATABASE_URL=postgresql://...
