# --- Connexion Odoo (API externe JSON-RPC standard) ---
# URL de base de l'instance Odoo, SANS le suffixe /jsonrpc (ajouté automatiquement par le client)
ODOO_BASE_URL=https://mycompany.odoo.com
# Nom de la base de données Odoo
ODOO_DB=mycompany_prod
# ID numérique de l'utilisateur API (uid)
ODOO_UID=17
# Clé API de l'utilisateur (générée dans Odoo : Paramètres > Utilisateurs > Clés API)
# Ne jamais committer une vraie valeur ici.
ODOO_API_KEY=changeme

# --- HTTP ---
# Timeout des appels HTTP vers Odoo, en millisecondes
# NB : un scan ilike sur 2 champs (name+description) peut prendre ~12s sur une
# instance Odoo Online réelle avec un helpdesk.ticket volumineux ; 10000 est
# souvent trop juste, 20000 est plus sûr.
ODOO_HTTP_TIMEOUT_MS=20000
# Nombre de tentatives supplémentaires sur erreurs réseau/5xx uniquement (jamais sur auth/validation)
ODOO_HTTP_MAX_RETRIES=2
# Délai de base (ms) du backoff exponentiel entre les tentatives
ODOO_HTTP_RETRY_BASE_DELAY_MS=300

# --- Limites de réponse MCP ---
# Plafond dur du nombre de résultats retournés par appel, indépendant du "limit" demandé par le client MCP
MCP_MAX_RESULTS_PER_QUERY=50
# Longueur maximale (caractères) du contenu texte renvoyé (body/description tronqués au-delà)
MCP_MAX_CONTENT_LENGTH=2000

# --- Croisement search_all ---
# Score de similarité lexicale minimum (0..1) pour retenir une relation entre un article et un ticket
CROSS_SEARCH_MIN_SCORE=0.15

# --- Recherche sémantique (embeddings locaux, voir `npm run reindex`) ---
# Modèle d'embedding local (transformers.js/ONNX, aucune clé API, téléchargé une fois puis mis en cache)
EMBEDDING_MODEL_ID=Xenova/all-MiniLM-L6-v2
# Répertoire local du cache vectoriel (jamais committé)
EMBEDDING_CACHE_DIR=.cache/embeddings
# Longueur max (caractères) du texte envoyé au modèle d'embedding
EMBEDDING_MAX_TEXT_LENGTH=1000
# Durée (ms) après laquelle le cache est considéré "stale" si non réindexé
EMBEDDING_CACHE_STALE_AFTER_MS=21600000
# Score cosinus minimum (0..1) pour qu'un résultat sémantique soit retenu
SEMANTIC_MIN_SCORE=0.35
# Nombre max de candidats sémantiques considérés avant troncature à `limit`
SEMANTIC_TOP_K=20
# Poids du score lexical / sémantique dans le mode hybride (doivent normalement sommer à 1)
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_SEMANTIC_WEIGHT=0.5

# --- Journalisation ---
# Niveau de log : error | warn | info | debug
LOG_LEVEL=info
